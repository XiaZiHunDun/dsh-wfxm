{
  "name": "@dsh-wfxm/mail",
  "version": "0.1.0",
  "description": "dsh-wfxm read-only mail (J1): IMAP search/read through two narrow tools",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib",
    "scripts/mail-query.py",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
