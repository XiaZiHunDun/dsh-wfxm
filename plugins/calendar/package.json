{
  "name": "@dsh-wfxm/calendar",
  "version": "0.1.0",
  "description": "dsh-wfxm server-side calendar (J4): local event store exposed through three narrow tools",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dsh-wfxm/sql-migrate": "workspace:*",
    "better-sqlite3": "^13.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
