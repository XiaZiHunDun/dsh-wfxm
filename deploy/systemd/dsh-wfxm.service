[Unit]
Description=dsh-wfxm agent (Feishu long connection, task runtime, outbox)
Documentation=file:/opt/dsh-wfxm/current/docs/README.md
After=network-online.target
Wants=network-online.target
# Startup failures exit 1 (docs/16 §四), so systemd retries a broken install a
# few times and then stops instead of looping forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=dshwfxm
Group=dshwfxm
WorkingDirectory=/opt/dsh-wfxm/current
EnvironmentFile=/etc/dsh-wfxm/env
Environment=NODE_ENV=production
# dsh (executor child) keeps sessions and credentials under $HOME/.dsh. The
# real home stays out of reach (ProtectHome=yes); this is a writable stand-in.
Environment=HOME=/var/lib/dsh-wfxm/home
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DSH_WFXM_DATA_DIR=/var/lib/dsh-wfxm
# ExecStart must use the distribution Node (24 LTS). Do not point it at nvm.
ExecStart=/usr/bin/node scripts/serve.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077

# Hardening (docs/16 §三). ReadWritePaths is the only writable surface: data,
# backups, and nothing under /opt (releases are swapped by symlink, not in-place).
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# @system-service predates Landlock (kernel 5.13), so its three syscalls are
# denied by the filter and dsh's sandbox probe reports SANDBOX_UNAVAILABLE.
# bwrap is not a fallback here: CapabilityBoundingSet= (below) leaves it no
# CAP_SYS_ADMIN in its user namespace, so mount propagation fails. Landlock
# needs no capabilities, only these syscalls.
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
ReadWritePaths=/var/lib/dsh-wfxm /var/backups/dsh-wfxm

[Install]
WantedBy=multi-user.target
