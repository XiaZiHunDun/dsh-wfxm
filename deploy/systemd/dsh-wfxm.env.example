# /etc/dsh-wfxm/env — non-secret only, root:dshwfxm 0640 (docs/16 §二).
# Secrets never go here: only reference names/paths to credential files.
DSH_WFXM_DATA_DIR=/var/lib/dsh-wfxm
DSH_WFXM_CHANNEL=feishu
DSH_WFXM_FOREGROUND=orchestrator
DSH_WFXM_DECIDE_RUNNER=sdk
DSH_WFXM_DSH_BIN=/usr/local/bin/dsh
DSH_WFXM_EXECUTOR_TIMEOUT_MS=600000
# Copy $HOME/.dsh/integrations/dsh-feishu/config.json and $HOME/.dsh/.credentials.yaml
# into /etc/dsh-wfxm/credentials (root:dshwfxm 0640) — ProtectHome hides $HOME.
DSH_WFXM_FEISHU_CONFIG=/etc/dsh-wfxm/credentials/feishu.json
DSH_WFXM_CREDENTIALS=/etc/dsh-wfxm/credentials/credentials.yaml
# Optional (svcops / notify, docs/05 Step 4):
# DSH_WFXM_EXPECTED_PORTS=3080,8787
# DSH_WFXM_INSPECT_THRESHOLDS={"diskUsedPct":85}
# DSH_WFXM_NTFY_TOPIC=
# DSH_WFXM_NTFY_URL=

# G2/G3 定时巡检：0 关闭；日报按本机时区，-1 关闭。
DSH_WFXM_PATROL_INTERVAL_MINUTES=15
DSH_WFXM_DIGEST_HOUR=9
# DSH_WFXM_PATROL_TARGET=host-58
# 让 dsh 子进程（执行器里的 svc_report）与宿主读同一个 ops.sqlite。
DSH_WFXM_AUDIT_DB=/var/lib/dsh-wfxm/ops.sqlite
# 定时备份（dsh-wfxm-backup.timer，docs/16 §七）：目录须与 unit 的 ReadWritePaths 一致。
DSH_WFXM_BACKUP_DIR=/var/backups/dsh-wfxm
# 保留最近 N 份归档；0 = 不清理。
DSH_WFXM_BACKUP_KEEP=7
# B4-b 工作区隔离（Slice U）：1 = git 项目按任务建 worktree；默认关闭。
# DSH_WFXM_WORKTREE_ISOLATION=1

# svcops 写操作（start/stop/restart）的提权路径：root 侧白名单 helper（unix socket）。
# 服务本身 NoNewPrivileges=yes，sudo 无法提权，所以不要再用 sudoers 那条路径；
# helper 与 client 由 deploy/install.sh 安装（dsh-wfxm-unit-control.service）。
DSH_WFXM_UNIT_CONTROL=/usr/local/sbin/dsh-wfxm-unit-client
