# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
out/
lib/
*.tsbuildinfo

# 日志与缓存
*.log
logs/
.cache/
.turbo/

# 环境与密钥（绝不入库）
.env
.env.*
!.env.example
*.pem
*.key

# 运行时数据（会话、审计、本地库）
.data/
*.sqlite
*.sqlite3
*.db

# 评测运行记录（A6 归档物，含执行环境信息，不入库）
bench/results/

# 本地运行态与工具缓存（开发机专属，不入库）
.wfxm/
.trae/
.trae-html-share-packages/
# /eval promote 的候选草稿；人工确认后移到 agent-eval/tasks 并提 PR
eval/candidates/
# P2-5 生产脱敏轨迹只留本机，不上传公共仓
eval/trajectory/

# 编辑器与系统
.DS_Store
.idea/
.vscode/

# scripts/lib holds runtime helpers (not build output)
!scripts/lib/
